<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parcial1.Pages.ContactsMainPage"
             Title="Contacts">
    <VerticalStackLayout Margin="15">
        <Label 
            Text="My Contacts!"
            FontSize="24"
            HorizontalOptions="Center" />
        <SearchBar Placeholder="Search contacts..." x:Name="searchBar"/>
        <Label x:Name="noContactsLabel"
               Text="No contacts found!"
               FontSize="18"
               HorizontalOptions="Center"
               IsVisible="False" />

        <ListView x:Name="contactList" ItemSelected="OnContactSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}"
                              Detail="{Binding Phone}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Text="Add Contact"
                HorizontalOptions="Center"
                Clicked="OnAddContactClicked"/>

    </VerticalStackLayout>
</ContentPage>