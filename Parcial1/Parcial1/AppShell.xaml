<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Parcial1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Parcial1"
    xmlns:pages="clr-namespace:Parcial1.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="Olive"
    Shell.TabBarTitleColor="Wheat"
    Shell.TabBarForegroundColor="Yellow"
    Title="Parcial1">

    <TabBar>
        <Tab Route="MainPage" Title="Home" Icon="dotnet_bot.png">
            <ShellContent Title="Home"
                          ContentTemplate="{DataTemplate pages:MainPage}" />
        </Tab>
        <Tab Route="NewsPage"
             Title="News"
             Icon="dotnet_bot.png">
            <ShellContent Title="News"
                          ContentTemplate="{DataTemplate pages:NewsPage}" />
            <ShellContent Title="Sports News"
                          ContentTemplate="{DataTemplate pages:NewsPage}" />
            <ShellContent Title="International News"
                          ContentTemplate="{DataTemplate pages:NewsPage}" />
        </Tab>
        <Tab Route="SettingsPage"
             Title="Settings"
             Icon="dotnet_bot.png">
            <ShellContent Title="Settings"
                          ContentTemplate="{DataTemplate pages:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
